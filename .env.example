# KnowledgeBridge configuration. Copy to .env for local development.
# Demo-only defaults are safe to commit; replace every secret before deployment.
APP_NAME=KnowledgeBridge
ENVIRONMENT=development
JWT_SECRET=change-this-in-production-knowledgebridge-demo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# SQLite is the zero-setup default. PostgreSQL is supported with:
# DATABASE_URL=postgresql+psycopg2://knowledgebridge:knowledgebridge@postgres:5432/knowledgebridge
DATABASE_URL=sqlite:///./database/knowledgebridge.db
DEMO_PASSWORD=DemoPass!2026
SEED_DEMO_DATA=true

# Optional read-only GitHub integration. Never store a token in the database.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# Optional OpenAI-compatible LLM adapter. If unset, the deterministic local
# extractive engine is used; no network model is called and no key is required.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Demo data / freshness policy
STALE_AFTER_DAYS=120
